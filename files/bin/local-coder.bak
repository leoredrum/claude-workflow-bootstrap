#!/bin/bash

# local-coder - Stub task handler for local AI projects
# Reads task file and writes stub result to RESULT.md
# Does NOT execute any commands from task content

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print usage
usage() {
    echo "Usage: local-coder <task-file-path>" >&2
    echo "  task-file-path: Path to the task file to process" >&2
    exit 1
}

# Check arguments
if [ $# -ne 1 ]; then
    usage
fi

TASK_FILE="$1"

# Validate task file exists
if [ ! -f "$TASK_FILE" ]; then
    echo -e "${RED}Error: Task file not found: $TASK_FILE${NC}" >&2
    exit 1
fi

# Read task content (safely, no execution)
TASK_CONTENT=$(cat "$TASK_FILE")

# Determine output directory
# Prefer .project-ai/ if it exists or can be created, otherwise use current directory
OUTPUT_DIR=""
if [ -d ".project-ai" ] || mkdir -p .project-ai 2>/dev/null; then
    OUTPUT_DIR=".project-ai"
else
    OUTPUT_DIR="."
fi

OUTPUT_FILE="${OUTPUT_DIR}/RESULT.md"

# Generate timestamp
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Write stub result
cat > "$OUTPUT_FILE" <<EOF
# Task Result

**Status:** STUB

**Task File:** \`$TASK_FILE\`

**Timestamp:** $TIMESTAMP

---

## Note

This is a stub result generated by local-coder.

The task has been read but not yet processed by an AI model.

**Next Steps:**
- Integrate with oMLX API for local processing
- Or use OpenAI-compatible API endpoint
- Result will replace this stub with actual completion

---

## Task Content

\`\`\`
$TASK_CONTENT
\`\`\`

---

*Generated by local-coder stub handler*
EOF

# Success
echo -e "${GREEN}✓ Stub result written to: $OUTPUT_FILE${NC}"
echo -e "${YELLOW}→ Task ready for AI processing${NC}"
echo ""
echo "Task preview:"
echo "$TASK_CONTENT" | head -3
echo "..."
echo "  ($TASK_FILE)"

exit 0
