#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"

# Update skills repository
echo "Updating mattpocock/skills..."
cd "$PROJECT_ROOT/third_party/mattpocock-skills"
git pull --quiet
cd "$PROJECT_ROOT"

# Re-run install with --force
"$SCRIPT_DIR/bootstrap-install-skills" --force

echo "Skills updated successfully!"
