#!/bin/bash

# get-secret - Secure secret retrieval utility
# Reads secrets from secure storage and outputs to stdout

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print usage
usage() {
    echo "Usage: get-secret <secret-name>" >&2
    echo "  secret-name: Name of the secret to retrieve" >&2
    echo "" >&2
    echo "Environment variables:" >&2
    echo "  SECRETS_DIR: Directory containing secret files (default: ~/.secrets)" >&2
    exit 1
}

# Check arguments
if [ $# -ne 1 ]; then
    usage
fi

SECRET_NAME="$1"

# Set secrets directory
SECRETS_DIR="${SECRETS_DIR:-$HOME/.secrets}"

# Validate secrets directory exists
if [ ! -d "$SECRETS_DIR" ]; then
    echo -e "${RED}Error: Secrets directory not found: $SECRETS_DIR${NC}" >&2
    exit 1
fi

# Construct secret file path
# Support both .secret and no extension
SECRET_FILE=""
if [ -f "$SECRETS_DIR/$SECRET_NAME.secret" ]; then
    SECRET_FILE="$SECRETS_DIR/$SECRET_NAME.secret"
elif [ -f "$SECRETS_DIR/$SECRET_NAME" ]; then
    SECRET_FILE="$SECRETS_DIR/$SECRET_NAME"
else
    echo -e "${RED}Error: Secret not found: $SECRET_NAME${NC}" >&2
    exit 1
fi

# Read and output secret (trim whitespace)
SECRET_VALUE=$(cat "$SECRET_FILE" | tr -d ' \n\t')

echo -n "$SECRET_VALUE"

exit 0
