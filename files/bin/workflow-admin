#!/usr/bin/env python3
"""workflow-admin - maintenance CLI for claude-workflow-bootstrap."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from workflow_db import get_db


def find_project_root() -> Path:
    """Find project root with .project-ai."""
    cwd = Path.cwd()
    while cwd != cwd.parent:
        if (cwd / ".project-ai").exists():
            return cwd
        cwd = cwd.parent
    return Path.cwd()


def check_command_exists(cmd: str) -> bool:
    """Check if a command is available."""
    try:
        subprocess.run(
            ["which", cmd],
            capture_output=True,
            check=False,
            timeout=5
        )
        return True
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def check_file_exists(path: Path | str) -> bool:
    """Check if a file exists."""
    return Path(path).exists()


def cmd_health(args) -> None:
    """Check system health."""
    verbose = getattr(args, 'verbose', False)

    if verbose:
        print("System Health Check")
        print("=" * 50)
    else:
        print("health", end="")

    issues = []

    # Check core binaries
    if verbose:
        print("\nCore Binaries:")
    binaries = [
        ("claude-plan", "Formal development mode"),
        ("local-coder", "Local AI executor"),
        ("workflow-orchestrator", "Workflow orchestration CLI"),
        ("workflow-query", "Workflow state query"),
        ("bootstrap-verify", "Installation verification"),
    ]

    missing_binaries = []
    for cmd, desc in binaries:
        in_path = check_command_exists(cmd)
        in_bin = check_file_exists(Path(__file__).parent / cmd)
        if verbose:
            status = "OK" if (in_path or in_bin) else "MISSING"
            location = "PATH" if in_path else ("bin" if in_bin else "MISSING")
            print(f"  {status} {cmd:20} ({desc}) [{location}]")
        if not (in_path or in_bin):
            issues.append(f"{cmd} not found")
            missing_binaries.append(cmd)

    # Check Ollama
    ollama_ok = check_command_exists("ollama")
    if not ollama_ok:
        issues.append("Ollama not installed")

    has_model = False
    if ollama_ok:
        try:
            result = subprocess.run(
                ["ollama", "list"],
                capture_output=True,
                text=True,
                timeout=10
            )
            has_model = "qwen2.5-coder:32b" in result.stdout
            if not has_model:
                issues.append("qwen2.5-coder:32b model not found")
        except Exception:
            issues.append("Cannot check Ollama models")

    if verbose:
        print("\nOllama Backend:")
        print(f"  {'OK' if ollama_ok else 'MISSING'} ollama")
        if ollama_ok:
            print(f"  {'OK' if has_model else 'MISSING'} qwen2.5-coder:32b")

    # Check recent violations
    project_root = find_project_root()
    project_ai = project_root / ".project-ai"

    violation_file = project_ai / "WORKFLOW_VIOLATIONS.md"
    violation_count = 0
    if violation_file.exists():
        content = violation_file.read_text()
        violation_count = content.count("## Violation")

    if verbose:
        print("\nRecent Violations:")
        if violation_count > 0:
            print(f"  {violation_count} violation(s) recorded")
        else:
            print("  OK No violations recorded")

    # Check stuck workers
    stuck_workers = 0
    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT worker_type, status, COUNT(*)
            FROM worker_registry
            GROUP BY worker_type, status
        """)
        workers = cur.fetchall()
        if verbose:
            print("\nWorker Status:")
            if workers:
                for wtype, status, count in workers:
                    print(f"  {wtype:15} {status:10} {count}")
            else:
                print("  OK No workers registered")
    except Exception:
        pass

    # Check context health
    WARN_HANDOFF_LINES = 300
    WARN_MEMORY_LINES = 500
    WARN_PATCH_LINES = 800
    WARN_SESSION_TASKS = 5

    context_warnings = 0

    handoff_file = project_ai / "HANDOFF.md"
    if handoff_file.exists():
        lines = len(handoff_file.read_text().splitlines())
        if lines >= WARN_HANDOFF_LINES:
            context_warnings += 1

    memory_file = project_ai / "MEMORY.md"
    if memory_file.exists():
        lines = len(memory_file.read_text().splitlines())
        if lines >= WARN_MEMORY_LINES:
            context_warnings += 1

    patch_file = project_ai / "PATCH.diff"
    if patch_file.exists():
        lines = len(patch_file.read_text().splitlines())
        if lines >= WARN_PATCH_LINES:
            context_warnings += 1

    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT COUNT(*) FROM attempts
            WHERE started_at > datetime('now', '-2 hours')
        """)
        session_tasks = cur.fetchone()[0]
        if session_tasks >= WARN_SESSION_TASKS:
            context_warnings += 1
        db.close()
    except:
        pass

    if context_warnings >= 2:
        issues.append(f"Context window: {context_warnings} warnings")

    if verbose:
        print("\nContext Health:")
        if context_warnings == 0:
            print("  OK Context window healthy")
        elif context_warnings == 1:
            print(f"  WARN {context_warnings} context warning")
        else:
            print(f"  DANGER {context_warnings} context warnings")

    # Summary
    if verbose:
        print("\n" + "=" * 50)
        if issues:
            print(f"FAILED - {len(issues)} issue(s):")
            for issue in issues:
                print(f"  - {issue}")
        else:
            print("PASSED")
    else:
        # Terse output
        if issues:
            danger = "DANGER" if len(issues) >= 3 else ("WARN" if len(issues) >= 1 else "OK")
            print(f" {danger} - {len(issues)} issue(s): " + ", ".join(issues))
        else:
            print(" OK")

    if issues:
        sys.exit(1)


def cmd_metrics(args) -> None:
    """Show workflow metrics."""
    print("📊 Workflow Metrics")
    print("=" * 50)

    project_root = find_project_root()
    db = get_db(project_root)

    # Task statistics
    print("\n📋 Task Statistics:")
    cur = db.conn.execute("""
        SELECT
            COUNT(*) as total,
            SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as completed,
            SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed,
            SUM(CASE WHEN status = 'blocked' THEN 1 ELSE 0 END) as blocked
        FROM tasks
        WHERE created_at > datetime('now', '-7 days')
    """)
    row = cur.fetchone()
    if row and row[0] > 0:
        print(f"  Last 7 days:")
        print(f"    Total:     {row[0]}")
        print(f"    Completed: {row[1] or 0}")
        print(f"    Failed:    {row[2] or 0}")
        print(f"    Blocked:   {row[3] or 0}")
    else:
        print("  No tasks in last 7 days")

    # Attempt statistics (actual executions)
    print("\n🔄 Attempt Statistics:")
    cur = db.conn.execute("""
        SELECT
            COUNT(*) as total,
            SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as completed,
            SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed,
            SUM(CASE WHEN status = 'blocked' THEN 1 ELSE 0 END) as blocked
        FROM attempts
        WHERE started_at > datetime('now', '-7 days')
    """)
    row = cur.fetchone()
    if row and row[0] > 0:
        total = row[0]
        completed = row[1] or 0
        failed = row[2] or 0
        blocked = row[3] or 0
        pass_rate = (completed / total * 100) if total > 0 else 0
        print(f"  Last 7 days:")
        print(f"    Total:     {total}")
        print(f"    PASS:      {completed} ({pass_rate:.1f}%)")
        print(f"    FAILED:    {failed}")
        print(f"    BLOCKED:   {blocked}")
    else:
        print("  No attempts in last 7 days")

    # Patch statistics
    print("\n📝 Patch Statistics:")
    cur = db.conn.execute("""
        SELECT
            COUNT(*) as total,
            AVG(LENGTH(patch_content)) as avg_size
        FROM patches
        WHERE created_at > datetime('now', '-7 days')
    """)
    row = cur.fetchone()
    if row and row[0] > 0:
        avg_size = row[1] or 0
        print(f"  Last 7 days:")
        print(f"    Patches:   {row[0]}")
        print(f"    Avg size:  {avg_size:.0f} bytes")
    else:
        print("  No patches in last 7 days")

    # Most modified files
    print("\n📁 Most Modified Files:")
    cur = db.conn.execute("""
        SELECT path, COUNT(*) as count
        FROM files_changed
        GROUP BY path
        ORDER BY count DESC
        LIMIT 5
    """)
    rows = cur.fetchall()
    if rows:
        for path, count in rows:
            print(f"    {count:3}  {path}")
    else:
        print("  No file changes recorded")


    db.close()


def cmd_failures(args) -> None:
    """Show failure taxonomy."""
    print("🔥 Failure Analysis")
    print("=" * 50)

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"

    # Check violations file
    violation_file = project_ai / "WORKFLOW_VIOLATIONS.md"
    if violation_file.exists():
        content = violation_file.read_text()
        violations = content.count("## Violation")
        print(f"\n📋 Workflow Violations: {violations}")

        # Categorize violations
        categories = {
            "WRONG_TARGET_FILE": 0,
            "BAD_ANCHOR": 0,
            "UNSAFE_OVERWRITE": 0,
            "LOOP_DETECTED": 0,
            "OTHER": 0
        }

        for line in content.splitlines():
            line_lower = line.lower()
            if "wrong_target" in line_lower or "wrong file" in line_lower:
                categories["WRONG_TARGET_FILE"] += 1
            elif "anchor" in line_lower and ("not_found" in line_lower or "ambiguous" in line_lower):
                categories["BAD_ANCHOR"] += 1
            elif "unsafe" in line_lower or "overwrite" in line_lower:
                categories["UNSAFE_OVERWRITE"] += 1
            elif "loop" in line_lower:
                categories["LOOP_DETECTED"] += 1
            elif "## Violation" in line:
                categories["OTHER"] += 1

        print("\n🏷️  Failure Types:")
        for category, count in categories.items():
            if count > 0:
                print(f"  {category:20} {count}")
    else:
        print("\n✓ No violations recorded")

    # Check failure docs
    failures_dir = project_ai / "docs" / "failures"
    if failures_dir.exists():
        failure_files = list(failures_dir.glob("*.md"))
        if failure_files:
            print(f"\n📄 Failure Documentation: {len(failure_files)} files")
            for f in sorted(failure_files):
                print(f"  - {f.name}")


def cmd_compact(args) -> None:
    """Compact memory/conversation data."""
    dry_run = getattr(args, 'dry_run', False)

    if dry_run:
        print("🔍 Compact Dry-Run Mode")
        print("=" * 50)
        print("Would compact:")
        print("  - .project-ai/ATTEMPT_HISTORY.md")
        print("  - .project-ai/workflow_state.db")
        print("\nUse --apply to actually compact.")
        return

    print("🗜️  Compacting Workflow Data")
    print("=" * 50)

    project_root = find_project_root()
    compact_script = Path(__file__).parent / "memory_compactor.py"

    if not compact_script.exists():
        print("❌ memory_compactor.py not found")
        sys.exit(1)

    # Run compactor
    try:
        result = subprocess.run(
            ["python3", str(compact_script), str(project_root)],
            capture_output=True,
            text=True,
            timeout=30
        )
        print(result.stdout)
        if result.returncode != 0:
            print(f"❌ Compaction failed: {result.stderr}")
            sys.exit(1)
    except subprocess.TimeoutExpired:
        print("❌ Compaction timed out")
        sys.exit(1)
    except Exception as e:
        print(f"❌ Compaction error: {e}")
        sys.exit(1)

    print("✅ Compaction complete")


def cmd_stuck_workers(args) -> None:
    """Show stuck/stale workers."""
    print("👷 Worker Status Check")
    print("=" * 50)

    project_root = find_project_root()
    db = get_db(project_root)

    # Get all workers
    cur = db.conn.execute("""
        SELECT worker_id, worker_type, status,
               datetime(last_heartbeat) as heartbeat,
               datetime(last_heartbeat, '-5 minutes') as stale_time
        FROM worker_registry
        ORDER BY last_heartbeat DESC
    """)
    workers = cur.fetchall()
    db.close()

    if not workers:
        print("✓ No workers registered")
        return

    now = datetime.now()
    stuck = []

    print(f"\n{'Worker ID':<25} {'Type':<15} {'Status':<10} {'Last Heartbeat':<20} {'State':<10}")
    print("-" * 90)

    for worker_id, wtype, status, heartbeat_str, _ in workers:
        try:
            if heartbeat_str:
                heartbeat = datetime.fromisoformat(heartbeat_str.replace(" ", "T"))
                age = (now - heartbeat).total_seconds()
                if age > 300:  # 5 minutes
                    state = "STUCK"
                    stuck.append(worker_id)
                elif age > 60:
                    state = "STALE"
                else:
                    state = "OK"
            else:
                state = "NO_HEARTBEAT"
                stuck.append(worker_id)
            heartbeat_display = heartbeat_str[:19] if heartbeat_str else "N/A"
        except:
            state = "ERROR"
            heartbeat_display = "ERROR"

        print(f"{worker_id:<25} {wtype:<15} {status:<10} {heartbeat_display:<20} {state:<10}")

    if stuck:
        print(f"\n⚠️  {len(stuck)} stuck worker(s) detected")
        print("\nTo remove stuck workers, use workflow-query:")
        for worker_id in stuck:
            print(f"  workflow-query unregister-worker {worker_id}")
    else:
        print("\n✓ All workers healthy")


def cmd_clean(args) -> None:
    """Clean temporary test artifacts."""
    apply = getattr(args, 'apply', False)

    if not apply:
        print("🧹 Clean Dry-Run Mode")
        print("=" * 50)
        print("Would clean:")
        print("  - /tmp/edit-mode-test*")
        print("  - /tmp/*workflow-test*")
        print("  - /tmp/.claude-* (temp session dirs)")
        print("\nUse --apply to actually clean.")
        return

    print("🧹 Cleaning Temporary Artifacts")
    print("=" * 50)

    import shutil

    cleaned = 0

    # Clean test directories
    for path in Path("/tmp").glob("edit-mode-test*"):
        if path.is_dir():
            print(f"  Removing: {path.name}")
            shutil.rmtree(path)
            cleaned += 1

    for path in Path("/tmp").glob("*workflow-test*"):
        if path.is_dir():
            print(f"  Removing: {path.name}")
            shutil.rmtree(path)
            cleaned += 1

    # Clean temp claude dirs (be careful)
    for path in Path("/tmp").glob(".claude-*"):
        if path.is_dir() and "tasks" in str(path):
            # Only clean if it looks like a temp session
            tasks_dir = path / "tasks"
            if tasks_dir.exists():
                # Check if old (more than 1 day)
                stat = path.stat()
                age = (now := datetime.now()).timestamp() - stat.st_mtime
                if age > 86400:  # 1 day
                    print(f"  Removing: {path.name} (old)")
                    shutil.rmtree(path)
                    cleaned += 1

    print(f"\n✅ Cleaned {cleaned} item(s)")


def cmd_context(args) -> None:
    """Check context window health with four-level danger rating."""
    verbose = getattr(args, 'verbose', False)

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"

    # Pressure score thresholds (0-100 scale)
    # Each metric contributes weighted percentage to total score

    def normalize_value(value: int, max_ref: int) -> float:
        """Normalize value to 0-1 scale based on max reference."""
        return min(value / max_ref, 1.0)

    # Collect metrics
    metrics = {}

    # Check HANDOFF.md (30% weight)
    if verbose:
        print("\nHANDOFF.md:")
    handoff_file = project_ai / "HANDOFF.md"
    HANDOFF_MAX = 500  # Reference max for 100% pressure
    if handoff_file.exists():
        lines = len(handoff_file.read_text().splitlines())
        pressure = normalize_value(lines, HANDOFF_MAX)
        metrics['handoff'] = pressure
        if verbose:
            status = "OK" if pressure < 0.5 else ("WARN" if pressure < 0.8 else "DANGER")
            print(f"  {status} {lines} lines (pressure: {pressure*100:.0f}%)")
    else:
        if verbose:
            print("  OK File not found")
        metrics['handoff'] = 0.0

    # Check MEMORY.md (20% weight)
    if verbose:
        print("\nMEMORY.md:")
    memory_file = project_ai / "MEMORY.md"
    MEMORY_MAX = 800  # Reference max
    if memory_file.exists():
        lines = len(memory_file.read_text().splitlines())
        pressure = normalize_value(lines, MEMORY_MAX)
        metrics['memory'] = pressure
        if verbose:
            status = "OK" if pressure < 0.5 else ("WARN" if pressure < 0.8 else "DANGER")
            print(f"  {status} {lines} lines (pressure: {pressure*100:.0f}%)")
    else:
        if verbose:
            print("  OK File not found")
        metrics['memory'] = 0.0

    # Check PATCH.diff (25% weight)
    if verbose:
        print("\nPATCH.diff:")
    patch_file = project_ai / "PATCH.diff"
    PATCH_MAX = 1200  # Reference max
    if patch_file.exists():
        lines = len(patch_file.read_text().splitlines())
        pressure = normalize_value(lines, PATCH_MAX)
        metrics['patch'] = pressure
        if verbose:
            status = "OK" if pressure < 0.5 else ("WARN" if pressure < 0.8 else "DANGER")
            print(f"  {status} {lines} lines (pressure: {pressure*100:.0f}%)")
    else:
        if verbose:
            print("  OK File not found")
        metrics['patch'] = 0.0

    # Check session task count (15% weight)
    if verbose:
        print("\nSession Tasks:")
    SESSION_MAX = 10  # Reference max
    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT COUNT(*) FROM attempts
            WHERE started_at > datetime('now', '-2 hours')
        """)
        session_tasks = cur.fetchone()[0]
        pressure = normalize_value(session_tasks, SESSION_MAX)
        metrics['session'] = pressure
        if verbose:
            status = "OK" if pressure < 0.5 else ("WARN" if pressure < 0.8 else "DANGER")
            print(f"  {status} {session_tasks} tasks (pressure: {pressure*100:.0f}%)")
        db.close()
    except Exception as e:
        if verbose:
            print(f"  WARN Cannot check: {e}")
        metrics['session'] = 0.0

    # Check git diff size (10% weight)
    if verbose:
        print("\nGit Diff Size:")
    GIT_DIFF_MAX = 400  # Reference max
    try:
        result2 = subprocess.run(
            ["git", "diff"],
            capture_output=True,
            text=True,
            timeout=10,
            cwd=project_root
        )
        if result2.stdout.strip():
            actual_diff_lines = len([l for l in result2.stdout.splitlines() if l.startswith("+") or l.startswith("-")])
            pressure = normalize_value(actual_diff_lines, GIT_DIFF_MAX)
            metrics['git_diff'] = pressure
            if verbose:
                status = "OK" if pressure < 0.5 else ("WARN" if pressure < 0.8 else "DANGER")
                print(f"  {status} ~{actual_diff_lines} changed lines (pressure: {pressure*100:.0f}%)")
        else:
            if verbose:
                print("  OK No uncommitted changes")
            metrics['git_diff'] = 0.0
    except Exception as e:
        if verbose:
            print(f"  WARN Cannot check: {e}")
        metrics['git_diff'] = 0.0

    # Calculate weighted pressure score
    weights = {
        'handoff': 0.30,
        'memory': 0.20,
        'patch': 0.25,
        'session': 0.15,
        'git_diff': 0.10,
    }

    total_pressure = sum(metrics.get(k, 0) * w for k, w in weights.items())

    # Determine danger level
    # SAFE: < 30%
    # WARN: 30-55%
    # ROTATE_SOON: 55-80%
    # ROTATE_NOW: >= 80%
    if total_pressure < 0.30:
        danger_level = "SAFE"
        danger_color = "\033[92m"  # Green
    elif total_pressure < 0.55:
        danger_level = "WARN"
        danger_color = "\033[93m"  # Yellow
    elif total_pressure < 0.80:
        danger_level = "ROTATE_SOON"
        danger_color = "\033[93m"  # Yellow
    else:
        danger_level = "ROTATE_NOW"
        danger_color = "\033[91m"  # Red

    reset_color = "\033[0m"

    # Summary
    if verbose:
        print("\n" + "=" * 50)
        print(f"Pressure Score: {total_pressure*100:.0f}%")
        print(f"Danger Level:   {danger_color}{danger_level}{reset_color}")

        # Action recommendations
        print("\nRecommendations:")
        if danger_level == "SAFE":
            print("  OK Context window is healthy")
            print("  OK Continue normal operations")
        elif danger_level == "WARN":
            print("  WARN Context pressure is elevated")
            print("  INFO Consider: workflow-admin handoff (when convenient)")
        elif danger_level == "ROTATE_SOON":
            print("  WARN Context window is under stress")
            print("  INFO Recommend: workflow-admin handoff before new tasks")
        else:  # ROTATE_NOW
            print("  CRITICAL Context window exhausted")
            print("  REQUIRED: workflow-admin handoff")
            print("  Then start a new claude-plan session")
    else:
        # Terse output
        summary = f"context {total_pressure*100:.0f}% {danger_color}{danger_level}{reset_color}"
        if danger_level == "SAFE":
            summary += " - healthy"
        elif danger_level == "WARN":
            summary += " - elevated"
        elif danger_level == "ROTATE_SOON":
            summary += " - under stress"
        else:
            summary += " - exhausted"
        print(summary)

    if danger_level == "ROTATE_NOW":
        sys.exit(1)


def cmd_handoff(args) -> None:
    """Generate session handoff file."""
    print("🤝 Generating Session Handoff")
    print("=" * 50)

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"
    full_mode = getattr(args, 'full', False)

    ts = datetime.now().strftime('%m/%d %H:%M')
    handoff_content = f"# Handoff {ts}\n"

    # Read current goal from TASK.md if exists
    task_file = project_ai / "TASK.md"
    if task_file.exists():
        task_content = task_file.read_text()
        # Extract first heading or paragraph
        for line in task_content.splitlines()[:10]:
            if line.strip() and not line.startswith("#"):
                handoff_content += f"**Goal**: {line}\n"
                break
    else:
        handoff_content += "**Goal**: No active task\n"

    # Current branch (compact)
    if full_mode:
        handoff_content += "\n## Branch\n"
    try:
        result = subprocess.run(
            ["git", "branch", "--show-current"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        branch = result.stdout.strip()
        if full_mode:
            handoff_content += f"`{branch}`\n"
        else:
            handoff_content += f" **Branch**: `{branch}`"

        # Get latest commit
        result2 = subprocess.run(
            ["git", "log", "--oneline", "-1"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        if full_mode:
            handoff_content += f"Latest: {result2.stdout.strip()}\n"
        else:
            handoff_content += f" **Last**: {result2.stdout.strip()}"
    except Exception:
        if full_mode:
            handoff_content += "Unknown\n"

    if not full_mode:
        handoff_content += "\n"

    # Recent tasks (compact: show count + last 2)
    if full_mode:
        handoff_content += "\n## Recent Tasks\n"
        task_limit = 5
    else:
        handoff_content += "**Tasks**: "
        task_limit = 2

    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT t.summary, a.status, a.completed_at
            FROM attempts a
            JOIN tasks t ON a.task_id = t.id
            ORDER BY a.completed_at DESC
            LIMIT ?
        """, (task_limit,))
        rows = cur.fetchall()
        if rows:
            if full_mode:
                for summary, status, _ in rows:
                    status_emoji = "✅" if status == "completed" else "❌"
                    handoff_content += f"- {status_emoji} {summary}\n"
            else:
                completed = sum(1 for _, s, _ in rows if s == "completed")
                handoff_content += f"{completed}/{len(rows)} done"
                for summary, status, _ in rows[:2]:
                    if status == "completed":
                        handoff_content += f", {summary[:30]}"
                handoff_content += "\n"
        else:
            handoff_content += "- No recent tasks\n" if full_mode else "none\n"
        db.close()
    except Exception:
        handoff_content += "- Cannot load tasks\n" if full_mode else "?(error)\n"

    # Modified files (compact: count only)
    if full_mode:
        handoff_content += "\n## Modified Files\n"
    else:
        handoff_content += "**Changes**: "

    try:
        result = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        files = result.stdout.strip().splitlines() if result.stdout.strip() else []
        if full_mode:
            if files:
                for f in files:
                    handoff_content += f"- `{f}`\n"
            else:
                handoff_content += "- No uncommitted changes\n"
        else:
            handoff_content += f"{len(files)} files\n" if files else "none\n"
    except Exception:
        handoff_content += "- Cannot check\n" if full_mode else "?(error)\n"

    # Next steps (compact)
    if full_mode:
        handoff_content += "\n## Next Steps\n"
        handoff_content += "1. Run `workflow-admin resume` to get continuation prompt\n"
        handoff_content += "2. Start new claude-plan session\n"
        handoff_content += "3. Paste the resume prompt\n"
    else:
        handoff_content += "**Next**: `workflow-admin resume`\n"

    # Write handoff file
    output_file = project_ai / "SESSION_HANDOFF.md"
    output_file.write_text(handoff_content)

    print(f"✅ Handoff: {output_file}")
    if not full_mode:
        print("   (use --full for detailed output)")

def cmd_resume(args) -> None:
    """Generate resume prompt for new session."""
    print("🔄 Session Resume Prompt")
    print("=" * 50)

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"
    full_mode = getattr(args, 'full', False)

    ts = datetime.now().strftime('%m/%d %H:%M')
    resume_prompt = f"# Resume {ts}\n\n"

    # Read handoff file (compact: just key info)
    handoff_file = project_ai / "SESSION_HANDOFF.md"
    if handoff_file.exists():
        handoff_content = handoff_file.read_text()
        if full_mode:
            resume_prompt += f"## Previous Handoff\n{handoff_content}\n\n"
        else:
            # Extract key info from handoff (Goal, Branch, Tasks, Changes)
            for line in handoff_content.splitlines():
                if any(kw in line for kw in ["**Goal**", "**Branch**", "**Last**", "**Tasks**", "**Changes**", "**Next**"]):
                    resume_prompt += line + "\n"
            resume_prompt += "\n"

    # Read HANDOFF.md for context (compact: first 15 lines)
    handoff_md = project_ai / "HANDOFF.md"
    if handoff_md.exists():
        content = handoff_md.read_text()
        lines_md = content.splitlines()
        if full_mode:
            if len(lines_md) > 30:
                resume_prompt += f"## HANDOFF.md (first 30 of {len(lines_md)} lines)\n"
                resume_prompt += "\n".join(lines_md[:30])
                resume_prompt += f"\n\n... ({len(lines_md) - 30} more lines)\n"
            else:
                resume_prompt += f"## HANDOFF.md\n{content}\n"
        else:
            # Compact: first 15 lines
            if len(lines_md) > 15:
                resume_prompt += f"## HANDOFF.md (first 15 of {len(lines_md)} lines)\n"
                resume_prompt += "\n".join(lines_md[:15])
                resume_prompt += f"\n\n... ({len(lines_md) - 15} more lines)\n"
            else:
                resume_prompt += f"## HANDOFF.md\n{content}\n"
        resume_prompt += "\n"

    # Git status (compact: count only)
    resume_prompt += "## Git Status\n"
    try:
        result = subprocess.run(
            ["git", "status", "--short"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        files = result.stdout.strip().splitlines() if result.stdout.strip() else []
        if full_mode:
            if result.stdout.strip():
                resume_prompt += f"```\n{result.stdout}```\n\n"
            else:
                resume_prompt += "*No uncommitted changes*\n\n"
        else:
            resume_prompt += f"{len(files)} modified files\n\n"
    except Exception as e:
        resume_prompt += f"*Cannot check status: {e}*\n\n"

    # Continuation instruction
    if full_mode:
        resume_prompt += "## Continuation\n\n"
        resume_prompt += "Please continue from where the previous session left off. "
        resume_prompt += "Review the handoff info above and proceed with the next steps.\n"
    else:
        resume_prompt += "**Continue**: Review handoff above and proceed.\n"

    print("\n" + "=" * 50)
    print(resume_prompt)
    print("=" * 50)
    print("\n💡 Copy the above prompt into your new claude-plan session")

def cmd_snapshot(args) -> None:
    """Create a session snapshot with current state."""
    print("📸 Creating Session Snapshot")
    print("=" * 50)

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"

    # Create snapshots directory
    snapshots_dir = project_ai / "session_snapshots"
    snapshots_dir.mkdir(parents=True, exist_ok=True)

    # Generate timestamp
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    snapshot_file = snapshots_dir / f"{timestamp}.json"

    # Collect snapshot data
    snapshot_data = {
        "timestamp": datetime.now().isoformat(),
        "project_root": str(project_root),
    }

    # Get git branch
    try:
        result = subprocess.run(
            ["git", "branch", "--show-current"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        snapshot_data["git_branch"] = result.stdout.strip()
    except Exception as e:
        snapshot_data["git_branch"] = f"unknown: {e}"

    # Get current task (TASK.md first 5 lines)
    task_file = project_ai / "TASK.md"
    if task_file.exists():
        task_content = task_file.read_text()
        lines = task_content.splitlines()
        snapshot_data["current_task"] = "\n".join(lines[:5])
    else:
        snapshot_data["current_task"] = None

    # Get recent tasks (limit 3)
    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT t.summary, a.status, a.completed_at
            FROM attempts a
            JOIN tasks t ON a.task_id = t.id
            ORDER BY a.completed_at DESC
            LIMIT 3
        """)
        rows = cur.fetchall()
        snapshot_data["recent_tasks"] = [
            {
                "summary": row[0],
                "status": row[1],
                "completed_at": row[2]
            }
            for row in rows
        ]
        db.close()
    except Exception as e:
        snapshot_data["recent_tasks"] = []
        snapshot_data["recent_tasks_error"] = str(e)

    # Get workflow status
    try:
        db = get_db(project_root)
        cur = db.conn.execute("""
            SELECT
                COUNT(*) as total,
                SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as completed,
                SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed
            FROM attempts
            WHERE started_at > datetime('now', '-7 days')
        """)
        row = cur.fetchone()
        snapshot_data["workflow_status"] = {
            "total_attempts_7d": row[0],
            "completed_7d": row[1] or 0,
            "failed_7d": row[2] or 0,
        }
        db.close()
    except Exception as e:
        snapshot_data["workflow_status"] = {"error": str(e)}

    # Get recent failures (limit 2)
    try:
        db = get_db(project_root)
        failures = db.get_recent_failures(limit=2)
        snapshot_data["recent_failures"] = [
            {
                "summary": f["summary"],
                "status": f["status"],
                "completed_at": f["completed_at"]
            }
            for f in failures
        ]
        db.close()
    except Exception as e:
        snapshot_data["recent_failures"] = []
        snapshot_data["recent_failures_error"] = str(e)

    # Get modified files
    try:
        result = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=project_root
        )
        if result.stdout.strip():
            snapshot_data["modified_files"] = result.stdout.strip().splitlines()
        else:
            snapshot_data["modified_files"] = []
    except Exception as e:
        snapshot_data["modified_files"] = []
        snapshot_data["modified_files_error"] = str(e)

    # Write snapshot
    with open(snapshot_file, 'w') as f:
        json.dump(snapshot_data, f, indent=2)

    print(f"✅ Snapshot saved: {snapshot_file}")
    print(f"\n📊 Snapshot Summary:")
    print(f"  Branch:        {snapshot_data.get('git_branch', 'N/A')}")
    print(f"  Recent tasks:  {len(snapshot_data.get('recent_tasks', []))}")
    print(f"  Recent failures: {len(snapshot_data.get('recent_failures', []))}")
    print(f"  Modified files: {len(snapshot_data.get('modified_files', []))}")


def cmd_runtime_budget(args) -> None:
    """Report runtime output budget usage."""
    verbose = getattr(args, 'verbose', False)

    def estimate_output_tokens(text: str) -> int:
        """Estimate tokens from output text (1 token ≈ 4 chars for code)."""
        if not text:
            return 0
        return len(text) // 4

    project_root = find_project_root()
    project_ai = project_root / ".project-ai"
    db = get_db(project_root)

    # 1. Current session runtime output estimate (last 2 hours)
    print("\n📊 Runtime Output Budget")
    print("=" * 50)

    cur = db.conn.execute("""
        SELECT a.result_summary, LENGTH(a.result_summary) as output_size,
               a.status, a.completed_at
        FROM attempts a
        WHERE a.completed_at > datetime('now', '-2 hours')
        ORDER BY a.completed_at DESC
    """)
    recent_attempts = cur.fetchall()

    session_output_chars = sum(a[1] or 0 for a in recent_attempts)
    session_output_tokens = estimate_output_tokens("".join(a[0] or "" for a in recent_attempts))

    if verbose:
        print(f"\nCurrent Session (last 2 hours):")
        print(f"  Attempts:        {len(recent_attempts)}")
        print(f"  Output chars:    {session_output_chars:,}")
        print(f"  Est. tokens:     ~{session_output_tokens:,}")
    else:
        print(f" session {len(recent_attempts)} attempts, ~{session_output_tokens:,} tokens")

    # 2. Last 5 maximum outputs (all time)
    cur = db.conn.execute("""
        SELECT a.id, t.summary, LENGTH(a.result_summary) as output_size,
               a.status, a.completed_at
        FROM attempts a
        JOIN tasks t ON a.task_id = t.id
        WHERE a.result_summary IS NOT NULL AND a.result_summary != ''
        ORDER BY output_size DESC
        LIMIT 5
    """)
    max_outputs = cur.fetchall()

    if verbose:
        print(f"\n📈 Top 5 Largest Outputs:")
        for idx, (attempt_id, summary, size, status, completed_at) in enumerate(max_outputs, 1):
            summary_short = (summary[:40] + "...") if len(summary) > 40 else summary
            print(f"  {idx}. {summary_short:45} {size:>8,} chars ({status})")
    else:
        if max_outputs:
            max_size = max_outputs[0][2] if max_outputs else 0
            print(f" max_alltime {max_size:,} chars")

    # 3. Reviewer/tester output size
    # Reviewer outputs are from attempts with executor='reviewer'
    cur = db.conn.execute("""
        SELECT executor, COUNT(*) as count,
               SUM(LENGTH(result_summary)) as total_output
        FROM attempts
        WHERE executor IN ('reviewer', 'tester', 'claude-reviewer', 'claude-tester')
          AND result_summary IS NOT NULL
        GROUP BY executor
    """)
    reviewer_stats = cur.fetchall()

    if verbose:
        print(f"\n🔍 Reviewer/Tester Output:")
        if reviewer_stats:
            for executor, count, total_output in reviewer_stats:
                avg_output = total_output // count if count > 0 else 0
                print(f"  {executor:20} {count:3} attempts, avg {avg_output:,} chars")
        else:
            print("  No reviewer/tester attempts recorded")
    else:
        if reviewer_stats:
            total = sum(s[2] or 0 for s in reviewer_stats)
            count = sum(s[1] or 0 for s in reviewer_stats)
            print(f" reviewer {count} attempts, ~{total:,} chars total")

    # 4. Handoff sizes
    handoff_sizes = []
    handoff_file = project_ai / "HANDOFF.md"
    if handoff_file.exists():
        handoff_sizes.append(("HANDOFF.md", len(handoff_file.read_text())))

    session_handoff = project_ai / "SESSION_HANDOFF.md"
    if session_handoff.exists():
        handoff_sizes.append(("SESSION_HANDOFF.md", len(session_handoff.read_text())))

    if verbose:
        print(f"\n🤝 Handoff Files:")
        if handoff_sizes:
            for name, size in handoff_sizes:
                print(f"  {name:25} {size:,} chars (~{size//4:,} tokens)")
        else:
            print("  No handoff files found")
    else:
        if handoff_sizes:
            total_handoff = sum(s[1] for s in handoff_sizes)
            print(f" handoff {len(handoff_sizes)} files, ~{total_handoff:,} chars")

    # Budget analysis
    if verbose:
        print(f"\n💰 Budget Analysis:")
        # Assuming 200K context, with ~30% for output
        output_budget = 60000  # 60K tokens for output
        output_used_pct = min(100, (session_output_tokens / output_budget) * 100)

        print(f"  Output budget:    ~{output_budget:,} tokens (30% of 200K context)")
        print(f"  Session output:   ~{session_output_tokens:,} tokens ({output_used_pct:.1f}%)")

        if output_used_pct < 30:
            status = "OK"
        elif output_used_pct < 60:
            status = "WARN"
        else:
            status = "DANGER"
        print(f"  Status:           {status}")

    db.close()


def cmd_prompt_budget(args) -> None:
    """Report prompt/token budget usage."""
    verbose = getattr(args, 'verbose', False)

    # Helper to estimate tokens (rough: 1 line ≈ 3 tokens for code/docs)
    def estimate_tokens(lines: int) -> int:
        return int(lines * 3)

    # Core CLAUDE.md files
    global_claude = Path.home() / ".claude" / "CLAUDE.md"
    local_claude = Path.cwd() / "CLAUDE.md"

    total_lines = 0
    total_tokens = 0

    for name, path in [
        ("~/.claude/CLAUDE.md", global_claude),
        ("~/CLAUDE.md", local_claude),
    ]:
        if path.exists():
            lines = len(path.read_text().splitlines())
            tokens = estimate_tokens(lines)
            if verbose:
                print(f"  {name:25} {lines:3} lines (~{tokens:3} tokens)")
            total_lines += lines
            total_tokens += tokens

    if verbose:
        print(f"  {'Subtotal':25} {total_lines:3} lines (~{total_tokens:3} tokens)")

    # Orchestrator scripts
    orch_base = Path(__file__).parent
    orch_files = [
        ("workflow_orchestrator.py", 209),
        ("workflow_query.py", 144),
        ("workflow-admin", 912),
    ]

    orch_lines = 0
    orch_tokens = 0
    for name, lines in orch_files:
        tokens = estimate_tokens(lines)
        if verbose:
            print(f"  {name:25} {lines:3} lines (~{tokens:3} tokens)")
        orch_lines += lines
        orch_tokens += tokens
    if verbose:
        print(f"  {'Subtotal':25} {orch_lines:3} lines (~{orch_tokens:3} tokens)")

    # Skills index
    skills_dir = Path.home() / ".claude" / "skills"
    skill_count = 0
    if skills_dir.exists():
        skill_count = len(list(skills_dir.glob("**/SKILL.md")))
    skill_tokens = skill_count * 20  # ~20 tokens per skill entry

    if verbose:
        print(f"  Skill definitions        {skill_count:2} entries (~{skill_tokens:3} tokens)")

    # Settings
    settings_file = Path.home() / ".claude" / "settings.json"
    settings_tokens = 0
    if settings_file.exists():
        lines = len(settings_file.read_text().splitlines())
        settings_tokens = int(lines / 2)  # JSON is dense
        if verbose:
            print(f"  settings.json           {lines:3} lines (~{settings_tokens:3} tokens)")

    # Session overhead summary
    overhead_total = total_tokens + orch_tokens + skill_tokens + settings_tokens

    # Budget breakdown
    budget_used = overhead_total + 10000  # + session memory
    budget_remaining = 200000 - budget_used

    if verbose:
        print("\nSession Overhead:")
        print(f"  CLAUDE.md files        ~{total_tokens:3} tokens")
        print(f"  Orchestrator code      ~{orch_tokens:3} tokens")
        print(f"  Skills index           ~{skill_tokens:3} tokens")
        print(f"  Settings               ~{settings_tokens:3} tokens")
        print(f"  {'='*30}")
        print(f"  TOTAL OVERHEAD         ~{overhead_total:3} tokens")

        # Compression analysis
        original_estimate = 4350
        compression_pct = int((1 - overhead_total / original_estimate) * 100)
        print(f"\nCompression Analysis:")
        print(f"  Original (est):        ~{original_estimate} tokens")
        print(f"  Compressed (current):  ~{overhead_total} tokens")
        print(f"  Reduction:             ~{compression_pct}%")

        # Budget breakdown
        print(f"\nToken Budget (200K context):")
        print(f"  System overhead:       ~{overhead_total} tokens")
        print(f"  Session memory:        ~10,000 tokens")
        print(f"  Available for code:    ~{budget_remaining} tokens")
        print(f"  Utilization:           {int(budget_used/2000)}%")
        print(f"\nReport complete. Overhead is {'healthy' if overhead_total < 2000 else 'HIGH'}")
    else:
        # Terse output
        health = "OK" if overhead_total < 2000 else "HIGH"
        utilization = int(budget_used / 2000)
        print(f"budget {health} - {overhead_total} overhead, {utilization}% utilized, ~{budget_remaining} available")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="workflow-admin - maintenance CLI for claude-workflow-bootstrap"
    )
    parser.add_argument("-v", "--verbose", action="store_true",
                       help="Show detailed output (default: terse)")

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # health command
    subparsers.add_parser("health", help="Check system health")

    # metrics command
    subparsers.add_parser("metrics", help="Show workflow metrics")

    # failures command
    subparsers.add_parser("failures", help="Show failure taxonomy")

    # compact command
    compact_p = subparsers.add_parser("compact", help="Compact workflow data")
    compact_p.add_argument("--dry-run", action="store_true", help="Show what would be compacted")

    # stuck-workers command
    subparsers.add_parser("stuck-workers", help="Show stuck/stale workers")

    # clean command
    clean_p = subparsers.add_parser("clean", help="Clean temporary artifacts")
    clean_p.add_argument("--apply", action="store_true", help="Actually clean (dry-run by default)")

    # context command
    subparsers.add_parser("context", help="Check context window health")

    # handoff command
    handoff_p = subparsers.add_parser("handoff", help="Generate session handoff file")
    handoff_p.add_argument("--full", action="store_true", help="Include full details (default: compact)")

    # resume command
    resume_p = subparsers.add_parser("resume", help="Generate resume prompt for new session")
    resume_p.add_argument("--full", action="store_true", help="Include full details (default: compact)")

    # prompt-budget command
    subparsers.add_parser("prompt-budget", help="Report prompt/token budget usage")

    # runtime-budget command
    subparsers.add_parser("runtime-budget", help="Report runtime output budget usage")

    # snapshot command
    subparsers.add_parser("snapshot", help="Create session snapshot with current state")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "health": cmd_health,
        "metrics": cmd_metrics,
        "failures": cmd_failures,
        "compact": cmd_compact,
        "stuck-workers": cmd_stuck_workers,
        "clean": cmd_clean,
        "context": cmd_context,
        "handoff": cmd_handoff,
        "resume": cmd_resume,
        "prompt-budget": cmd_prompt_budget,
        "runtime-budget": cmd_runtime_budget,
        "snapshot": cmd_snapshot,
    }

    commands[args.command](args)


if __name__ == "__main__":
    main()
