#!/usr/bin/env bash
set -euo pipefail

# Resolve SCRIPT_DIR to absolute path, following symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
WORKER_PYTHON="$SCRIPT_DIR/local_coder_worker.py"

# Default model
MODEL="${LOCAL_CODER_MODEL:-qwen2.5-coder:32b}"
OLLAMA_ENDPOINT="${LOCAL_CODER_ENDPOINT:-http://127.0.0.1:11434}"

# Find project root
TASK_FILE="$1"
if [[ -z "$TASK_FILE" ]]; then
    echo "Usage: local-coder <task-file>" >&2
    exit 1
fi

if [[ "$TASK_FILE" == */.project-ai/TASK.md ]]; then
    PROJECT_ROOT="${TASK_FILE%/\.project-ai/TASK.md}"
else
    PROJECT_ROOT="$(pwd)"
fi

PROJECT_AI_DIR="$PROJECT_ROOT/.project-ai"

# Check Ollama availability
if ! command -v ollama &>/dev/null; then
    cat > "$PROJECT_AI_DIR/RESULT.md" << 'EOF'
# Implementation Result

**Status:** BLOCKED
**implementation_executor:** local-coder
**backend:** ollama
**Error:** ollama command not found. Please install Ollama first.

See https://ollama.com/download for installation instructions.
EOF
    exit 1
fi

# Check model availability
AVAILABLE_MODELS="$(ollama list 2>&1)"
if ! echo "$AVAILABLE_MODELS" | grep -qF "$MODEL"; then
    cat > "$PROJECT_AI_DIR/RESULT.md" << EOF
# Implementation Result

**Status:** BLOCKED
**implementation_executor:** local-coder
**backend:** ollama
**model_requested:** $MODEL
**Error:** Model not found in Ollama.

Available models:
$AVAILABLE_MODELS

Set LOCAL_CODER_MODEL environment variable to use a different model.
EOF
    exit 1
fi

# Create baseline git diff
cd "$PROJECT_ROOT"
if git rev-parse --git-dir &>/dev/null; then
    git diff HEAD > "$PROJECT_AI_DIR/.baseline.diff" 2>/dev/null || true
fi

# Run Python worker
python3 "$WORKER_PYTHON" \
    --task-file "$TASK_FILE" \
    --project-root "$PROJECT_ROOT" \
    --model "$MODEL" \
    --endpoint "$OLLAMA_ENDPOINT"
